@page
@model SistemaEscolar.Pages.BoletimModel
@using SistemaEscolar.Data
@{ ViewData["Title"] = "Boletim"; }

<div class="barra no-print"><h1>Boletim</h1>@if (Model.Matricula != null && Model.Linhas.Count > 0) {<button type="button" class="btn btn-sec" onclick="window.print()">Imprimir</button>}</div>
<div class="so-print doc-topo"><strong class="grande">@Escola.Nome</strong><span>Boletim escolar, emitido em @DateTime.Today.ToString("dd/MM/yyyy")</span></div>
@if (Escola.Contato != "") { <p class="suave doc-contato so-print">@Escola.Contato</p> }

@if (Model.Aluno == null)
{
    <div class="card vazio">Nenhum aluno ligado ao seu acesso. Fale com a secretaria.</div>
}
else
{
    @if (Model.Alunos.Count > 1)
    {
        <div class="abas no-print">
            @foreach (var a in Model.Alunos)
            {
                <a class="@(a.Id == Model.Aluno.Id ? "ativa" : "")" asp-page="Boletim" asp-route-alunoId="@a.Id">@a.Nome</a>
            }
        </div>
    }
    <p><strong>@Model.Aluno.Nome</strong>
        @if (Model.Matricula?.Turma != null)
        {
            <span class="suave"> - @Model.Matricula.Turma.Nome, @Model.Matricula.AnoLetivo</span>
        }
    </p>

    @if (Model.Matricula == null)
    {
        <div class="card vazio">O aluno ainda não está em uma turma.</div>
    }
    else if (Model.Linhas.Count == 0)
    {
        <div class="card vazio">A turma ainda não tem disciplinas definidas.</div>
    }
    else
    {
        <div class="card tabela">
            <table>
                <thead>
                    <tr>
                        <th>Disciplina</th>
                        @for (int b = 1; b <= TabelaNotas.Bimestres; b++) { <th>@(b)º bim.</th> }
                        <th>Rec.</th><th>Média</th><th>Freq.</th><th>Situação</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in Model.Linhas)
                {
                    <tr>
                        <td>@l.Disciplina</td>
                        @foreach (var n in l.Notas) { <td>@(n?.ToString("0.0") ?? "-")</td> }
                        <td>@(l.Rec?.ToString("0.0") ?? "-")</td>
                        <td><strong>@(l.Media?.ToString("0.0") ?? "-")</strong></td>
                        <td>@(l.Freq?.ToString("0.#") is { } f ? f + "%" : "-")</td>
                        <td><span class="badge sit-@l.Situacao">@l.Situacao.Nome()</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p>Situação geral: <span class="badge sit-@Model.Geral">@Model.Geral.Nome()</span>
            @if (Model.FreqGeral != null)
            {
                <span class="suave"> &middot; Frequência geral: @Model.FreqGeral.Value.ToString("0.#")% (mínimo @Aprovacao.FrequenciaMinima.ToString("0.#")%)</span>
            }
        </p>
        <p class="suave">Aprovado com média anual a partir de @Aprovacao.MediaMinima.ToString("0.0"); de @Aprovacao.MediaRecuperacao.ToString("0.0") até abaixo de @Aprovacao.MediaMinima.ToString("0.0") o aluno faz recuperação (média final: @(Aprovacao.Modo switch { ModoRecuperacao.MaiorDasDuas => "a maior entre a média anual e a recuperação", ModoRecuperacao.SubstituiMedia => "a nota de recuperação", _ => "média anual e recuperação, divididas por 2" })); abaixo de @Aprovacao.MediaRecuperacao.ToString("0.0") é reprovado. Frequência geral abaixo do mínimo também reprova. A situação só é definida depois dos 4 bimestres.</p>
    }
}
