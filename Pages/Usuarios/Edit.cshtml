@page "{id:int}"
@model SistemaEscolar.Pages.Usuarios.EditModel
@{ ViewData["Title"] = "Editar funcionário"; ViewData["Edicao"] = true; }

<div class="barra"><h1>Editar funcionário</h1><a class="btn btn-sec" asp-page="Index">Voltar</a></div>
<form method="post" class="card" novalidate>
    <partial name="_Form" model="Model.Input" view-data="ViewData" />
    <div class="rodape-form"><button class="btn">Salvar</button></div>
</form>

@if (!Model.Eu)
{
    <form method="post" asp-page-handler="NovaSenha" asp-route-id="@Model.Id" style="margin-top:14px" onsubmit="return confirm('Gerar uma nova senha provisória? A senha atual deixa de valer.')">
        <button class="btn btn-sec">Gerar nova senha provisória</button>
    </form>
}
else
{
    <p class="suave">Você está editando o seu próprio acesso: as mudanças valem na hora.</p>
}
