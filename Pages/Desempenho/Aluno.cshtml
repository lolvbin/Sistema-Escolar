@page "{id:int}"
@using SistemaEscolar.Data
@model SistemaEscolar.Pages.Desempenho.AlunoModel
@{ ViewData["Title"] = "Desempenho do aluno"; }

<div class="barra">
    <h1>@Model.Matricula.Aluno!.Nome</h1>
    <span class="no-print">
        <button type="button" class="btn" onclick="window.print()">Imprimir</button>
        <a class="btn btn-sec" asp-page="Turma" asp-route-id="@Model.Matricula.TurmaId">Voltar</a>
    </span>
</div>
<div class="so-print doc-topo"><strong class="grande">@if (Escola.TemLogo) { <img class="doc-logo" src="/logo?v=@Escola.LogoVersao" alt="" /> }@Escola.Nome</strong><span>Boletim escolar, emitido em @DateTime.Today.ToString("dd/MM/yyyy")</span></div>
@if (Escola.Contato != "") { <p class="suave doc-contato so-print">@Escola.Contato</p> }
<p class="suave">@Model.Matricula.Turma!.Nome, @Model.Matricula.AnoLetivo</p>

@if (Model.Resultado.Linhas.Count == 0)
{
    <div class="card vazio">A turma ainda não tem disciplinas definidas.</div>
}
else
{
    <div class="card tabela">
        <table>
            <thead>
                <tr>
                    <th>Disciplina</th>
                    @for (int b = 1; b <= TabelaNotas.Bimestres; b++) { <th>@(b)º bim.</th> }
                    <th>Rec.</th><th>Média</th><th>Freq.</th><th>Situação</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var l in Model.Resultado.Linhas)
            {
                <tr>
                    <td>@l.Disciplina</td>
                    @foreach (var n in l.Notas) { <td>@(n?.ToString("0.0") ?? "-")</td> }
                    <td>@(l.Rec?.ToString("0.0") ?? "-")</td>
                    <td><strong>@(l.Media?.ToString("0.0") ?? "-")</strong></td>
                    <td>@(l.Freq?.ToString("0.#") is { } f ? f + "%" : "-")</td>
                    <td><span class="badge sit-@l.Situacao">@l.Situacao.Nome()</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p>Situação geral: <span class="badge sit-@Model.Resultado.Geral">@Model.Resultado.Geral.Nome()</span>
        @if (Model.Resultado.FreqGeral != null)
        {
            <span class="suave"> &middot; Frequência geral: @Model.Resultado.FreqGeral.Value.ToString("0.#")% (mínimo @Aprovacao.FrequenciaMinima.ToString("0.#")%)</span>
        }
        @if (Model.Resultado.FaltasAbonadas > 0) { <span class="suave"> &middot; @Model.Resultado.FaltasAbonadas falta(s) abonada(s)</span> }
    </p>
}

@if (Model.Aviso != null) { <div class="card aviso no-print">@Model.Aviso</div> }
@if (Model.Faltas.Count > 0)
{
    <form method="post" asp-page-handler="Abonar" asp-route-id="@Model.Matricula.Id" class="card tabela no-print">
        <h2>Abono de faltas</h2>
        <p class="suave">Falta justificada (atestado, por exemplo) não conta na frequência. Informe quantas faltas abonar em cada disciplina e bimestre e o motivo.</p>
        <table>
            <thead><tr><th>Disciplina</th><th>Bimestre</th><th>Faltas</th><th>Abonar</th><th>Motivo</th></tr></thead>
            <tbody>
            @foreach (var f in Model.Faltas)
            {
                <tr>
                    <td>@f.Disciplina</td><td>@(f.Bimestre)º</td><td>@f.Faltas</td>
                    <td><input name="Abono[@f.Chave]" value="@Model.Abono.GetValueOrDefault(f.Chave)" inputmode="numeric" maxlength="3" size="3" autocomplete="off" /></td>
                    <td>
                        <input name="Motivo[@f.Chave]" value="@Model.Motivo.GetValueOrDefault(f.Chave)" maxlength="200" autocomplete="off" />
                        @if (Model.Erros.TryGetValue(f.Chave, out var e)) { <span class="erro">@e</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <div class="rodape-form"><button class="btn">Salvar abonos</button></div>
    </form>
}
