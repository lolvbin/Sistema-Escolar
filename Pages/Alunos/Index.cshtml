@page
@using SistemaEscolar.Data
@model SistemaEscolar.Pages.Alunos.IndexModel
@{ ViewData["Title"] = "Alunos"; }

<div class="barra">
    <h1>Alunos</h1>
    @if (User.TemArea(SistemaEscolar.Data.Area.Matriculas)) { <a class="btn" asp-page="/Matriculas/Create">Nova matrícula</a> }
</div>

<p class="suave">O aluno é cadastrado ao fazer a matrícula. Aqui você consulta e corrige os dados.</p>

<form method="get" class="filtro">
    <input name="Busca" value="@Model.Busca" placeholder="Buscar aluno ou responsável" />
    <button class="btn btn-sec">Filtrar</button>
</form>

<div class="card tabela">
    @if (Model.Itens.Count == 0)
    {
        <div class="vazio">Nenhum aluno encontrado. Os alunos aparecem aqui depois da matrícula.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Aluno</th><th>Nascimento</th><th>Responsável</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Itens)
            {
                <tr>
                    <td>@a.Nome<br /><small>@a.Cpf</small></td>
                    <td>@a.DataNascimento?.ToString("dd/MM/yyyy")</td>
                    <td>@a.Academico.Nome<br /><small>@a.Academico.Telefone</small></td>
                    <td class="acoes"><a asp-page="Edit" asp-route-id="@a.Id">Editar</a> <a asp-page="Historico" asp-route-id="@a.Id">Histórico</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
