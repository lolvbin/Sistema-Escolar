@page
@using SistemaEscolar.Data
@model SistemaEscolar.Pages.IndexModel
@{
    ViewData["Title"] = "Início";
    if (Model.Perfil == Perfil.Funcionario)
    {
        ViewData["MatInfo"] = $"{Model.Total} cadastradas · {Model.Pendentes} pendentes";
    }
}

<h1>Olá, @User.Identity?.Name <span class="badge">@Model.Perfil.Nome()</span></h1>
<partial name="_Painel" model="Model.Perfil" />
