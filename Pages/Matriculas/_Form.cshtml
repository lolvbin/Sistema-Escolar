@using SistemaEscolar.Data
@model Matricula
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var edicao = ViewData["Edicao"] as bool? == true;
    var alunos = ViewData["Alunos"] as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<h2>Matrícula</h2>
<div class="grade">
    <div class="campo largo">
        <label asp-for="AlunoId"></label>
        @if (edicao)
        {
            <input asp-for="AlunoId" type="hidden" />
            <input value="@ViewData["AlunoNome"]" disabled />
        }
        else
        {
            <select asp-for="AlunoId" asp-items="alunos">
                <option value="">Selecione</option>
            </select>
            <span asp-validation-for="AlunoId" class="erro"></span>
            <small><a asp-page="/Alunos/Create">Cadastrar novo aluno</a></small>
        }
    </div>
    <div class="campo">
        <label asp-for="Serie"></label>
        <select asp-for="Serie" asp-items="Html.GetEnumSelectList<Serie>()">
            <option value="">Selecione</option>
        </select>
        <span asp-validation-for="Serie" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="Turno"></label>
        <select asp-for="Turno" asp-items="Html.GetEnumSelectList<Turno>()">
            <option value="">Selecione</option>
        </select>
        <span asp-validation-for="Turno" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="AnoLetivo"></label>
        <select asp-for="AnoLetivo">
            @foreach (var ano in Matricula.AnosPermitidos)
            {
                <option value="@ano" selected="@(ano == Model.AnoLetivo)">@ano</option>
            }
        </select>
        <span asp-validation-for="AnoLetivo" class="erro"></span>
    </div>
    <div class="campo">
        <label asp-for="Status"></label>
        @if (edicao)
        {
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusMatricula>()"></select>
        }
        else
        {
            <input value="Pendente" disabled />
        }
    </div>
</div>

<h2>Outras informações</h2>
<div class="campo">
    <label asp-for="Observacoes"></label>
    <textarea asp-for="Observacoes" rows="3"></textarea>
</div>

<div class="rodape-form">
    <button class="btn">Salvar</button>
    <a class="btn btn-sec" asp-page="Index">Cancelar</a>
</div>
