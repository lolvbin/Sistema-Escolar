@page
@model SistemaEscolar.Pages.Matriculas.IndexModel
@{ ViewData["Title"] = "Matrículas"; }

<div class="barra">
    <h1>Matrículas</h1>
    <a class="btn" asp-page="Create">Nova matrícula</a>
</div>

<form method="get" class="filtro">
    <input name="Busca" value="@Model.Busca" placeholder="Buscar aluno ou responsável" />
    <select asp-for="Status" asp-items="Html.GetEnumSelectList<SistemaEscolar.Data.StatusMatricula>()">
        <option value="">Todos os status</option>
    </select>
    <button class="btn btn-sec">Filtrar</button>
</form>

<div class="card tabela">
    @if (Model.Itens.Count == 0)
    {
        <div class="vazio">Nenhuma matrícula encontrada.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Aluno</th><th>Responsável</th><th>Série</th><th>Ano</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var m in Model.Itens)
            {
                <tr>
                    <td>@m.Aluno?.Nome</td>
                    <td>@m.Aluno?.Academico.Nome<br /><small>@m.Aluno?.Academico.Telefone</small></td>
                    <td>@Html.DisplayFor(_ => m.Serie) (@Html.DisplayFor(_ => m.Turno))</td>
                    <td>@m.AnoLetivo</td>
                    <td><span class="badge st-@m.Status">@Html.DisplayFor(_ => m.Status)</span></td>
                    <td class="acoes">
                        <a asp-page="Edit" asp-route-id="@m.Id">Editar</a>
                        <a asp-page="Delete" asp-route-id="@m.Id">Excluir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
