@page
@model SistemaEscolar.Pages.ConfiguracoesModel
@using SistemaEscolar.Data
@{ ViewData["Title"] = "Configurações"; }

<h1>Configurações</h1>
@if (Model.Aviso != null) { <div class="card aviso">@Model.Aviso</div> }

<form method="post" class="card" novalidate>
    <h2>Aprovação</h2>
    <div class="grade">
        <div class="campo">
            <label for="Minima">Média para aprovação (0 a 10)</label>
            <input id="Minima" name="Minima" value="@Model.Minima" inputmode="decimal" maxlength="4" autocomplete="off" />
            @if (Model.ErroMinima != null) { <span class="erro">@Model.ErroMinima</span> }
        </div>
        <div class="campo">
            <label for="Recuperacao">Média mínima para recuperação (0 a 10)</label>
            <input id="Recuperacao" name="Recuperacao" value="@Model.Recuperacao" inputmode="decimal" maxlength="4" autocomplete="off" />
            @if (Model.ErroRecuperacao != null) { <span class="erro">@Model.ErroRecuperacao</span> }
        </div>
        <div class="campo">
            <label for="Frequencia">Frequência mínima, em % de presença (0 a 100)</label>
            <input id="Frequencia" name="Frequencia" value="@Model.Frequencia" inputmode="decimal" maxlength="5" autocomplete="off" />
            @if (Model.ErroFrequencia != null) { <span class="erro">@Model.ErroFrequencia</span> }
        </div>
    </div>
    <h2>Recuperação</h2>
    <div class="campo">
        <label for="Modo">Como a nota de recuperação entra na média final</label>
        <select id="Modo" name="Modo">
            <option value="0" selected="@(Model.Modo == 0)">Média das duas: (média anual + recuperação) / 2</option>
            <option value="1" selected="@(Model.Modo == 1)">Maior das duas: vale a maior entre a média anual e a recuperação</option>
            <option value="2" selected="@(Model.Modo == 2)">Substitui a média: a nota de recuperação vira a média final</option>
        </select>
    </div>
    <p class="suave">Em qualquer modelo, a média final precisa atingir a média de aprovação. Frequência geral abaixo do mínimo reprova o aluno. A situação só é definida depois dos 4 bimestres.</p>
    <div class="rodape-form"><button class="btn">Salvar</button></div>

    <h2>Atraso nas mensalidades</h2>
    <div class="grade">
        <div class="campo">
            <label for="Multa">Multa por atraso, % do valor (0 a 20)</label>
            <input id="Multa" name="Multa" value="@Model.Multa" inputmode="decimal" maxlength="5" autocomplete="off" />
            @if (Model.ErroMulta != null) { <span class="erro">@Model.ErroMulta</span> }
        </div>
        <div class="campo">
            <label for="Juros">Juros ao mês, % (0 a 10)</label>
            <input id="Juros" name="Juros" value="@Model.Juros" inputmode="decimal" maxlength="5" autocomplete="off" />
            @if (Model.ErroJuros != null) { <span class="erro">@Model.ErroJuros</span> }
        </div>
    </div>
    <p class="suave">A multa é cobrada uma vez, a partir do dia seguinte ao vencimento. Os juros são simples e proporcionais aos dias de atraso (% ao mês ÷ 30 por dia). Vale para as cobranças ainda não pagas; o que já foi pago mantém o valor recebido. Na baixa, o funcionário pode isentar a multa e os juros.</p>
</form>
