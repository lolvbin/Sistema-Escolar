@page "{perfil?}"
@using SistemaEscolar.Data
@model SistemaEscolar.Pages.PreviaModel
@{ ViewData["Title"] = "Prévia - " + Model.Perfil.Nome(); }

<div class="aviso-previa">Prévia estática com dados fictícios. Não é a tela real de ninguém.</div>

<nav class="abas">
    @foreach (var p in Enum.GetValues<Perfil>())
    {
        <a asp-page="/Previa" asp-route-perfil="@p" class="@(p == Model.Perfil ? "ativa" : "")">@p.Nome()</a>
    }
</nav>

<h1>Visão do perfil: @Model.Perfil.Nome()</h1>
<partial name="_Painel" model="Model.Perfil" />
