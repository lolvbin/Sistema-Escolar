@inject IWebHostEnvironment Env
@{
    // Logo: a enviada em Configurações; se não houver, wwwroot/img/logo.svg (ou logo.png)
    var logo = new[] { "logo.svg", "logo.png" }.Where(f => System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "img", f))).Select(f => "/img/" + f).FirstOrDefault();
    if (SistemaEscolar.Data.Escola.TemLogo) logo = "/logo?v=" + SistemaEscolar.Data.Escola.LogoVersao; // a enviada pela tela vale mais que o arquivo
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @SistemaEscolar.Data.Escola.Nome</title>
    <script>
        // Aplica o tema antes de renderizar (evita piscar)
        (function () {
            var t = null;
            try { t = localStorage.getItem("tema"); } catch (e) { }
            if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.setAttribute("data-tema", t);
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <div class="wrap topo-in">
            <a class="marca" asp-page="/Index">@if (logo != null) { <img src="@logo" alt="" /> }<span>@SistemaEscolar.Data.Escola.Nome</span></a>
            <span class="menu"></span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-page="/Logout" class="sair">
                    <button type="submit" class="btn btn-sec">Sair</button>
                </form>
            }
            else
            {
                <a class="btn btn-sec" asp-page="/Login">Entrar</a>
            }
            <button type="button" id="tema-btn" class="btn btn-sec" aria-label="Alternar tema">Tema</button>
        </div>
    </header>
    <main class="wrap">
        @RenderBody()
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById("tema-btn").onclick = function () {
            var h = document.documentElement;
            var t = h.getAttribute("data-tema") === "dark" ? "light" : "dark";
            h.setAttribute("data-tema", t);
            try { localStorage.setItem("tema", t); } catch (e) { }
        };
    </script>
</body>
</html>
